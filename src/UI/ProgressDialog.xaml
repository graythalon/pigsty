<Window x:Class="Pigsty.UI.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Working..." Height="180" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelDarkBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Operation Title -->
            <TextBlock x:Name="OperationTitleBlock" Grid.Row="0" Text="Transferring files..."
                       FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12" />

            <!-- Detail / Current Item -->
            <TextBlock x:Name="StatusDetailBlock" Grid.Row="1" Text="Preparing..."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

            <!-- Progress Bar -->
            <ProgressBar x:Name="TaskProgressBar" Grid.Row="2" Height="8"
                         Minimum="0" Maximum="100" Value="0"
                         Background="{StaticResource PanelAltBrush}"
                         Foreground="{StaticResource AccentBlueBrush}"
                         BorderThickness="0" Margin="0,0,0,14" />

            <!-- Cancel Button -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
