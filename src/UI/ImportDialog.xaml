<Window x:Class="Pigsty.UI.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import to Android" Height="260" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelDarkBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="⬆️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Import Files to Android" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Description -->
            <TextBlock x:Name="FileCountLabel" Grid.Row="1" Text="Choose destination folder on device for 1 selected file:"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

            <!-- Folder Option Selector -->
            <ComboBox x:Name="TargetFolderCombo" Grid.Row="2" Style="{StaticResource CleanComboBoxStyle}"
                      Height="32" Margin="0,0,0,12">
                <ComboBoxItem Content="Download (Recommended)" Tag="Download" IsSelected="True" />
                <ComboBoxItem Content="DCIM / Camera (Photos &amp; Videos)" Tag="DCIM" />
                <ComboBoxItem Content="Pictures (Images &amp; Screenshots)" Tag="Pictures" />
                <ComboBoxItem Content="Music (Songs &amp; Audio)" Tag="Music" />
                <ComboBoxItem Content="Documents (PDFs &amp; Files)" Tag="Documents" />
                <ComboBoxItem Content="Movies (Videos &amp; Screen Records)" Tag="Movies" />
            </ComboBox>

            <!-- Info Note -->
            <TextBlock Grid.Row="3" Text="Files will be copied directly to your Android device via MTP without developer options."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" TextWrapping="Wrap" />

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Import" Style="{StaticResource PrimaryButtonStyle}"
                        Width="85" Click="ImportButton_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
