<Window x:Class="Pigsty.UI.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import" Height="185" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelDarkBrush}">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="↑" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderLabel" Text="Import" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="FileCountLabel" Grid.Row="1" Text="Destination folder:"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

            <ComboBox x:Name="TargetFolderCombo" Grid.Row="2" Style="{StaticResource CleanComboBoxStyle}"
                      Height="30" Margin="0,0,0,14">
                <ComboBoxItem Content="Download" Tag="Download" IsSelected="True" />
                <ComboBoxItem Content="DCIM" Tag="DCIM" />
                <ComboBoxItem Content="Pictures" Tag="Pictures" />
                <ComboBoxItem Content="Movies" Tag="Movies" />
                <ComboBoxItem Content="Music" Tag="Music" />
                <ComboBoxItem Content="Documents" Tag="Documents" />
            </ComboBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Width="76" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
                <Button Content="Import" Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Click="ImportButton_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
